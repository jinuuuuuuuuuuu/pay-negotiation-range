 "narrative": {
  "northStar": "협상 테이블 위의 노란 띠",
  "overview": "팀 발표 자료의 먹색과 노랑으로 짓는 업무 앱. 먹색은 지금 우리 회사의 상태를 담는 요약 카드와 선택된 탭에만, 노랑은 협상 구간의 띠와 그 화면으로 가는 주행동에만 쓴다. 나머지는 중성 회색 바탕과 흰 카드가 맡아 숫자가 먼저 읽히게 한다.",
  "keyCharacteristics": [
   "먹색 요약 카드 + 노란 협상 구간 줄",
   "협상 구간 그래프(우리 부담선이 업계 부담선과 만나는 곳이 상한, 하한~상한은 연한 노랑 면)",
   "중성 회색 바탕 위 흰 카드",
   "Pretendard 한 가족, 고정폭 숫자",
   "판정 색 세 가지는 노랑과 겹치지 않음"
  ],
  "rules": [
   {
    "name": "The 노랑은 면이다 Rule",
    "body": "노랑은 띠, 버튼, 상자의 면으로만 쓴다. 흰 바탕의 노란 글자는 금지(대비 부족). 노랑 위의 글자는 먹색.",
    "section": "colors"
   },
   {
    "name": "The 판정 색은 판정에만 Rule",
    "body": "파랑·초록·주황빨강은 구간 위치와 적자 여부 판정에만 쓴다. 장식이나 강조에 빌려 쓰지 않는다.",
    "section": "colors"
   },
   {
    "name": "The 숫자는 줄을 맞춘다 Rule",
    "body": "금액·비율이 나오는 표와 칸은 모두 고정폭 숫자(tabular-nums). 음수는 하이픈이 아니라 마이너스 기호(−).",
    "section": "typography"
   },
   {
    "name": "The 그림자 한 겹 Rule",
    "body": "카드 안에 그림자 있는 카드를 다시 넣지 않는다. 카드 안의 구분은 선(구분선 회색)이나 틴트로 한다.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do 협상 구간은 언제나 하한(노측 근거)과 상한(사측 근거)을 같은 그래프 위에 함께 그린다.",
   "Do 그래프는 막대와 선처럼 설명 없이 읽히는 모양으로, 화면 문구는 \"업계\"로 통일한다(업종 금지).",
   "Do 구간 노랑(#FFCD4A)은 띠·주행동·요약 줄의 면에만, 위 글자는 먹색으로 쓴다.",
   "Do 숫자 칸은 고정폭 숫자와 마이너스 기호(−)를 쓴다.",
   "Do 보류·비교 불가·예측 대상 아님 같은 상태는 숨기지 말고 보류 회색 상자로 이유와 함께 보여 준다.",
   "Do 터치 영역은 44px 이상, 포커스는 먹색 3px 링."
  ],
  "donts": [
   "Don't 흰 바탕에 노란 글자를 쓰지 않는다.",
   "Don't 판정 색(파랑·초록·주황빨강)을 장식이나 강조에 쓰지 않는다.",
   "Don't 카드 안에 그림자 있는 카드를 넣지 않는다(카드 안 구분은 선이나 틴트).",
   "Don't 크림·베이지 바탕으로 돌아가지 않는다(페이지 회색 #F3F3F2 유지).",
   "Don't 키트의 이미지·일러스트·아이콘을 가져오지 않는다.",
   "Don't 점 분포(strip plot), 범위 막대(fan) 같은 통계식 시각화를 쓰지 않는다."
  ]
 }
}